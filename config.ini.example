[fair_eva]
# FAIR EVA API base host (without trailing slash)
api_url = http://localhost

# FAIR EVA API port
api_port = 8080

# FAIR EVA API timeout (seconds)
api_timeout = 90

# Evaluation endpoint path (app builds: {api_url}:{api_port}{api_eval_path})
api_eval_path = /v1.0/rda/rda_all

# Optional plugin endpoint path or full URL.
# Leave empty to enable automatic discovery.
api_plugins_path =

# Optional local plugin catalog file (JSON list with id/label).
# Example includes:
# - oai_pmh => OAI-PMH
# - digital_csic => DIGITAL.CSIC
plugins_file = fair_eva_web_client/data/plugins_example.json
reports_dir = /tmp/fair_eva_web_client_reports

# Optional: store executed evaluations in SQLite to enable the
# "Evaluations" section in the UI.
store_evaluations = false

# SQLite file path for stored evaluations (JSON payload per run).
# Backup/retention of this database is the system administrator's responsibility.
evaluations_db_path = /tmp/fair_eva_web_client_evaluations.sqlite

# Optional UI settings
title = FAIR EVA
logo_url = https://digital.csic.es
logo_image = logo_fair_eosc.png

# Development mode settings
dev_mode = false
sample_file = fair_eva_web_client/data/salida_new.json
